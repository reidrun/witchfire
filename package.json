{
	"name": "witchfire",
	"version": "0.1.0",
	"description": "a wordpress block editor plugin for syntax highlighting code via Lumis",
	"author": "Alex Barber <alex@dangerinteractive.com>",
	"license": "GPL-3.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build --blocks-manifest --config webpack.config.mjs",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start --blocks-manifest --config webpack.config.mjs"
	},
	"dependencies": {
		"@lumis-sh/lumis": "^0.10.10",
		"@lumis-sh/themes": "^0.4.7",
		"@lumis-sh/wasm-bundle-full": "^0.2.1",
		"@lumis-sh/wasm-wgsl": "^0.26.4",
		"@wordpress/block-editor": "latest",
		"@wordpress/blocks": "latest",
		"@wordpress/i18n": "latest"
	},
	"devDependencies": {
		"@wordpress/scripts": "^37.2.0",
		"copy-webpack-plugin": "^14.0.0"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"core-js@3.51.0": true,
		"core-js-pure@3.51.0": true
	}
}
