{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "reidrun/witchfire",
	"version": "0.1.0",
	"title": "WitchFire",
	"category": "text",
	"icon": "editor-code",
	"description": "a syntax highlighted code block",
	"attributes": {
		"code": {
			"type": "string",
			"default": ""
		},
		"language": {
			"type": "string",
			"default": "plaintext"
		},
		"highlighted": {
			"type": "string",
			"source": "html",
			"selector": ".wp-block-reidrun-witchfire",
			"default": ""
		}
	},
	"example": {},
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"anchor": true,
		"html": false,
		"spacing": {
			"margin": [
				"top",
				"bottom"
			],
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"fontFamily": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": true
	},
	"textdomain": "witchfire",
	"editorScript": "file:./index.js",
	"editorStyle": [
		"file:./index.css",
		"reidrun-witchfire-lumis-theme"
	],
	"style": [
		"file:./style-index.css",
		"reidrun-witchfire-lumis-theme"
	]
}
